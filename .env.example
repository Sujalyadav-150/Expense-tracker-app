# Required for AI category suggestions (optional - app works without it)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://expense-tracker-app-mu-neon.vercel.app
OPENROUTER_APP_NAME=Expense Tracker

# Required for persistent user data (strongly recommended for production)
# Get from: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/expense-tracker
MONGODB_URI=your-mongodb-atlas-connection-string

# Optional: JWT secret for token signing (app uses fallback if not set)
JWT_SECRET=your-secure-jwt-secret-key-here

# Optional
NODE_ENV=production
